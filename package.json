{
  "name": "muso-dojo-next",
  "version": "1.0.0",
  "license": "AGPL-3.0-only",
  "private": false,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": "24.x",
    "pnpm": "11.19.0"
  },
  "scripts": {
    "dev": "concurrently -p none 'serwist build --watch' 'next dev'",
    "build": "next build && serwist build && node tools/verify_service_worker_audio_cache.mjs",
    "start": "next start",
    "preview": "next build && serwist build && node tools/verify_service_worker_audio_cache.mjs && next start",
    "lint": "eslint -c eslint.config.mjs",
    "lint:fix": "eslint -c eslint.config.mjs --fix",
    "lint:strict": "eslint -c eslint.strict.config.mjs --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:watch": "vitest",
    "audio:inspect": "python3 tools/audio/build_sample_packs.py inspect",
    "audio:build": "python3 tools/audio/build_sample_packs.py build",
    "audio:build:dry": "python3 tools/audio/build_sample_packs.py build --dry-run",
    "audio:verify": "python3 tools/audio/build_sample_packs.py verify",
    "sw:verify": "node tools/verify_service_worker_audio_cache.mjs",
    "format": "prettier --write --ignore-unknown .",
    "format:check": "prettier --check --ignore-unknown .",
    "check": "pnpm lint && pnpm typecheck",
    "check:strict": "pnpm lint:strict && pnpm typecheck",
    "check:ci": "pnpm format:check && pnpm check:strict && pnpm test:coverage && pnpm audio:verify && pnpm build",
    "clean": "rm -rf .next"
  },
  "dependencies": {
    "@musodojo/music-theory-data": "^43.0.0",
    "lucide-react": "^1.30.0",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@serwist/cli": "^9.5.11",
    "@serwist/next": "^9.5.11",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitest/coverage-v8": "4.1.10",
    "babel-plugin-react-compiler": "1.0.0",
    "concurrently": "^9.2.3",
    "esbuild": "^0.28.1",
    "eslint": "^9.39.4",
    "eslint-config-next": "16.3.0",
    "eslint-plugin-react": "^7.37.5",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.5",
    "serwist": "^9.5.11",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
